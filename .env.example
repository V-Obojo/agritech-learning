# Copy to .env.local and fill in. Never commit .env.local.
OPENAI_API_KEY=
# Model used by the in-app guide (Responses API), e.g. the model your key has access to.
OPENAI_MODEL=
# mock = deterministic offline guide (default, always used in tests); live = call OpenAI
GUIDE_MODE=mock
# Accounts (Auth.js / next-auth v4). Generate a long random secret; never commit it.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Database (libsql). Local file for development; a Turso libsql:// URL + token when deployed.
DATABASE_URL=file:./data/ovayi.db
DATABASE_AUTH_TOKEN=
