# Copy to .env.local and fill in. Never commit .env.local.
OPENAI_API_KEY=
# Model used by the in-app guide (Responses API), e.g. the model your key has access to.
OPENAI_MODEL=
# mock = deterministic offline guide (default, always used in tests); live = call OpenAI
GUIDE_MODE=mock
# Accounts (next-auth v4 Credentials + JWT). Required: set a long random secret yourself.
# Missing values fail with a setup message; the app never generates a secret.
# See README: Set up accounts locally. Never commit .env.local or print secrets.
NEXTAUTH_SECRET=
# Public origin used by auth callbacks; match your development port.
NEXTAUTH_URL=http://localhost:3000
# Database (libsql). Local file for development; a Turso libsql:// URL + token when deployed.
# Run npm run db:migrate before starting accounts. Drizzle CLI uses process env.
DATABASE_URL=file:./data/ovayi.db
DATABASE_AUTH_TOKEN=
